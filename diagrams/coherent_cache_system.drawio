        </mxCell>
        <mxCell id="v33" value="Rules for a SINGLE line address: I/I, S/I, I/S, S/S, E/I, I/E, M/I, I/M are legal stable pairs.&lt;br&gt;&lt;b&gt;FORBIDDEN:&lt;/b&gt; M + any non-I peer, E + any non-I peer (including E + S).&lt;br&gt;E/S → I on peer ownership/eviction; M → I after dirty writeback on ownership/eviction.&lt;br&gt;New local accesses must not outrun an in-flight snoop; BusUpgr revalidates state at grant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="655" width="1170" height="190"/>
        </mxCell>
